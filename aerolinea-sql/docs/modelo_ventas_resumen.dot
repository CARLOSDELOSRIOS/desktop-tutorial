digraph SalesSummary {
 graph [rankdir=LR,bgcolor=white,pad=0.3,nodesep=0.6,ranksep=0.6];
 node [shape=box,style="rounded,filled",fillcolor="#e8f2f5",color="#147d92",fontname="DejaVu Sans",fontsize=18,margin=0.18];
 edge [fontname="DejaVu Sans",fontsize=12,color="#60818e"];
 Persona->Tiquete [label="comprador / pasajero"];
 Tarifa->Tiquete [label="condición histórica"];
 Canal->Tiquete [label="punto de venta"];
 Tiquete->Pago [label="0..N"];
 Pago->Reembolso [label="0..1"];
}
