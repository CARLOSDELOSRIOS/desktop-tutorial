digraph ER {
graph [rankdir=LR,bgcolor="white",pad="0.25",nodesep="0.3",ranksep="0.8",fontname="DejaVu Sans"];
node [shape=plain,fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans",fontsize=9,color="#60818e"];
Airport [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Airport</B></FONT></TD></TR></TABLE>>];
Cabin [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Cabin</B></FONT></TD></TR></TABLE>>];
Person [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Person</B></FONT></TD></TR></TABLE>>];
Customer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Customer</B></FONT></TD></TR></TABLE>>];
Employee [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Employee</B></FONT></TD></TR></TABLE>>];
Aircraft [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Aircraft</B></FONT></TD></TR></TABLE>>];
AircraftSeat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>AircraftSeat</B></FONT></TD></TR></TABLE>>];
Route [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Route</B></FONT></TD></TR></TABLE>>];
Schedule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Schedule</B></FONT></TD></TR></TABLE>>];
Flight [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Flight</B></FONT></TD></TR></TABLE>>];
FlightSeat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>FlightSeat</B></FONT></TD></TR></TABLE>>];
CrewAssignment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>CrewAssignment</B></FONT></TD></TR></TABLE>>];
SalesChannel [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>SalesChannel</B></FONT></TD></TR></TABLE>>];
Fare [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Fare</B></FONT></TD></TR></TABLE>>];
Discount [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Discount</B></FONT></TD></TR></TABLE>>];
Ticket [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Ticket</B></FONT></TD></TR></TABLE>>];
Payment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Payment</B></FONT></TD></TR></TABLE>>];
Refund [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Refund</B></FONT></TD></TR></TABLE>>];
StatusEvent [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>StatusEvent</B></FONT></TD></TR></TABLE>>];
Person -> Customer [label="1 : 0..1\nPersonId"];
Person -> Employee [label="1 : 0..1\nPersonId"];
Aircraft -> AircraftSeat [label="1 : 0..N\nAircraftId"];
Cabin -> AircraftSeat [label="1 : 0..N\nCabinCode"];
Airport -> Route [label="1 : 0..N\nOriginCode"];
Airport -> Route [label="1 : 0..N\nDestinationCode"];
Route -> Schedule [label="1 : 0..N\nRouteId"];
Schedule -> Flight [label="1 : 0..N\nScheduleId"];
Aircraft -> Flight [label="1 : 0..N\nAircraftId"];
Flight -> FlightSeat [label="1 : 0..N\nFlightId,AircraftId"];
AircraftSeat -> FlightSeat [label="1 : 0..N\nAircraftId,SeatNo,CabinCode"];
Flight -> CrewAssignment [label="1 : 0..N\nFlightId"];
Employee -> CrewAssignment [label="1 : 0..N\nEmployeeId"];
Airport -> SalesChannel [label="0..1 : 0..N\nAirportCode"];
Route -> Fare [label="1 : 0..N\nRouteId"];
Cabin -> Fare [label="1 : 0..N\nCabinCode"];
FlightSeat -> Ticket [label="1 : 0..N\nFlightId,SeatNo,CabinCode"];
Person -> Ticket [label="1 : 0..N\nPassengerId"];
Person -> Ticket [label="1 : 0..N\nBuyerId"];
SalesChannel -> Ticket [label="1 : 0..N\nChannelId"];
Fare -> Ticket [label="1 : 0..N\nFareId"];
Discount -> Ticket [label="0..1 : 0..N\nDiscountId"];
Ticket -> Payment [label="1 : 0..N\nTicketId"];
Payment -> Refund [label="1 : 0..1\nPaymentId"];
Ticket -> StatusEvent [label="0..1 : 0..N\nTicketId"];
Flight -> StatusEvent [label="0..1 : 0..N\nFlightId"];
}
