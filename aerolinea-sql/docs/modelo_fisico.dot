digraph ER {
graph [rankdir=LR,bgcolor="white",pad="0.25",nodesep="0.3",ranksep="0.8",fontname="DejaVu Sans"];
node [shape=plain,fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans",fontsize=9,color="#60818e"];
Airport [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Airport</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AirportCode: char(3) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Name: nvarchar(100) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">City: nvarchar(80) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WindowsTZ: sysname </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">IanaTZ: varchar(50) </FONT></TD></TR></TABLE>>];
Cabin [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Cabin</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">CabinCode: varchar(3) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Name: nvarchar(30) </FONT></TD></TR></TABLE>>];
Person [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Person</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PersonId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FullName: nvarchar(120) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Email: varchar(160) ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">BirthDate: date ?</FONT></TD></TR></TABLE>>];
Customer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Customer</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PersonId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RegisteredAt: datetime2(0) </FONT></TD></TR></TABLE>>];
Employee [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Employee</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">EmployeeId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PersonId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RoleCode: varchar(10) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Active: bit </FONT></TD></TR></TABLE>>];
Aircraft [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Aircraft</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AircraftId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Registration: varchar(12) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Model: nvarchar(60) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Active: bit </FONT></TD></TR></TABLE>>];
AircraftSeat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>AircraftSeat</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AircraftId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">SeatNo: varchar(4) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">CabinCode: varchar(3) </FONT></TD></TR></TABLE>>];
Route [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Route</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RouteId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OriginCode: char(3) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DestinationCode: char(3) </FONT></TD></TR></TABLE>>];
Schedule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Schedule</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ScheduleId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RouteId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">IsoWeekday: tinyint </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DepartureLocal: time(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DurationMinutes: smallint </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ValidFrom: date </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ValidTo: date </FONT></TD></TR></TABLE>>];
Flight [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Flight</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FlightId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ScheduleId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AircraftId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FlightDate: date </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DepartureUtc: datetime2(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ArrivalUtc: datetime2(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Status: varchar(10) </FONT></TD></TR></TABLE>>];
FlightSeat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>FlightSeat</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FlightId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AircraftId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">SeatNo: varchar(4) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">CabinCode: varchar(3) </FONT></TD></TR></TABLE>>];
CrewAssignment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>CrewAssignment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FlightId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">EmployeeId: int </FONT></TD></TR></TABLE>>];
SalesChannel [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>SalesChannel</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ChannelId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Name: nvarchar(80) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Kind: varchar(8) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Address: nvarchar(200) ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Url: varchar(200) ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AirportCode: char(3) ?</FONT></TD></TR></TABLE>>];
Fare [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Fare</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FareId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RouteId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">CabinCode: varchar(3) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ValidFrom: datetime2(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ValidTo: datetime2(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Price: decimal(12,2) </FONT></TD></TR></TABLE>>];
Discount [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Discount</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DiscountId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Code: varchar(20) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PercentValue: decimal(5,2) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ValidFrom: datetime2(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ValidTo: datetime2(0) </FONT></TD></TR></TABLE>>];
Ticket [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Ticket</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">TicketId: bigint IDENTITY(1,1) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RequestKey: uniqueidentifier </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FlightId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">SeatNo: varchar(4) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">CabinCode: varchar(3) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PassengerId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">BuyerId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ChannelId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FareId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DiscountId: int ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OriginalPrice: decimal(12,2) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DiscountPercent: decimal(5,2) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">SoldAt: datetime2(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Status: varchar(10) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">CancelledAt: datetime2(0) ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">CancelReason: nvarchar(200) ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FinalPrice: decimal(12,2) COMPUTED PERSISTED ?</FONT></TD></TR></TABLE>>];
Payment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Payment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PaymentId: bigint IDENTITY(1,1) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">TicketId: bigint </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RequestKey: uniqueidentifier </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Amount: decimal(12,2) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Status: varchar(9) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Method: varchar(10) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PaidAt: datetime2(0) </FONT></TD></TR></TABLE>>];
Refund [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Refund</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RefundId: bigint IDENTITY(1,1) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PaymentId: bigint </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Amount: decimal(12,2) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RefundedAt: datetime2(0) </FONT></TD></TR></TABLE>>];
StatusEvent [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>StatusEvent</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">EventId: bigint IDENTITY(1,1) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">TicketId: bigint ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FlightId: int ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FromStatus: varchar(10) ?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ToStatus: varchar(10) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ChangedAt: datetime2(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Actor: sysname </FONT></TD></TR></TABLE>>];
Person -> Customer [label="1 : 0..1\nPersonId"];
Person -> Employee [label="1 : 0..1\nPersonId"];
Aircraft -> AircraftSeat [label="1 : 0..N\nAircraftId"];
Cabin -> AircraftSeat [label="1 : 0..N\nCabinCode"];
Airport -> Route [label="1 : 0..N\nOriginCode"];
Airport -> Route [label="1 : 0..N\nDestinationCode"];
Route -> Schedule [label="1 : 0..N\nRouteId"];
Schedule -> Flight [label="1 : 0..N\nScheduleId"];
Aircraft -> Flight [label="1 : 0..N\nAircraftId"];
Flight -> FlightSeat [label="1 : 0..N\nFlightId,AircraftId"];
AircraftSeat -> FlightSeat [label="1 : 0..N\nAircraftId,SeatNo,CabinCode"];
Flight -> CrewAssignment [label="1 : 0..N\nFlightId"];
Employee -> CrewAssignment [label="1 : 0..N\nEmployeeId"];
Airport -> SalesChannel [label="0..1 : 0..N\nAirportCode"];
Route -> Fare [label="1 : 0..N\nRouteId"];
Cabin -> Fare [label="1 : 0..N\nCabinCode"];
FlightSeat -> Ticket [label="1 : 0..N\nFlightId,SeatNo,CabinCode"];
Person -> Ticket [label="1 : 0..N\nPassengerId"];
Person -> Ticket [label="1 : 0..N\nBuyerId"];
SalesChannel -> Ticket [label="1 : 0..N\nChannelId"];
Fare -> Ticket [label="1 : 0..N\nFareId"];
Discount -> Ticket [label="0..1 : 0..N\nDiscountId"];
Ticket -> Payment [label="1 : 0..N\nTicketId"];
Payment -> Refund [label="1 : 0..1\nPaymentId"];
Ticket -> StatusEvent [label="0..1 : 0..N\nTicketId"];
Flight -> StatusEvent [label="0..1 : 0..N\nFlightId"];
}
