digraph ER {
graph [rankdir=LR,bgcolor="white",pad="0.25",nodesep="0.3",ranksep="0.8",fontname="DejaVu Sans"];
node [shape=plain,fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans",fontsize=9,color="#60818e"];
Airport [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Airport</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AirportCode: char(3) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Name: nvarchar(100) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">City: nvarchar(80) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WindowsTZ: sysname </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">IanaTZ: varchar(50) </FONT></TD></TR></TABLE>>];
Cabin [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Cabin</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">CabinCode: varchar(3) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Name: nvarchar(30) </FONT></TD></TR></TABLE>>];
Employee [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Employee</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">EmployeeId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PersonId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RoleCode: varchar(10) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Active: bit </FONT></TD></TR></TABLE>>];
Aircraft [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Aircraft</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AircraftId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Registration: varchar(12) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Model: nvarchar(60) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Active: bit </FONT></TD></TR></TABLE>>];
AircraftSeat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>AircraftSeat</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AircraftId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">SeatNo: varchar(4) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">CabinCode: varchar(3) </FONT></TD></TR></TABLE>>];
Route [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Route</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RouteId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OriginCode: char(3) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DestinationCode: char(3) </FONT></TD></TR></TABLE>>];
Schedule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Schedule</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ScheduleId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RouteId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">IsoWeekday: tinyint </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DepartureLocal: time(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DurationMinutes: smallint </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ValidFrom: date </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ValidTo: date </FONT></TD></TR></TABLE>>];
Flight [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>Flight</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FlightId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ScheduleId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AircraftId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FlightDate: date </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">DepartureUtc: datetime2(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ArrivalUtc: datetime2(0) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Status: varchar(10) </FONT></TD></TR></TABLE>>];
FlightSeat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>FlightSeat</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FlightId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AircraftId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">SeatNo: varchar(4) </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">CabinCode: varchar(3) </FONT></TD></TR></TABLE>>];
CrewAssignment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#123d51"><FONT COLOR="white"><B>CrewAssignment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FlightId: int </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">EmployeeId: int </FONT></TD></TR></TABLE>>];
Aircraft -> AircraftSeat [label="1 : 0..N\nAircraftId"];
Cabin -> AircraftSeat [label="1 : 0..N\nCabinCode"];
Airport -> Route [label="1 : 0..N\nOriginCode"];
Airport -> Route [label="1 : 0..N\nDestinationCode"];
Route -> Schedule [label="1 : 0..N\nRouteId"];
Schedule -> Flight [label="1 : 0..N\nScheduleId"];
Aircraft -> Flight [label="1 : 0..N\nAircraftId"];
Flight -> FlightSeat [label="1 : 0..N\nFlightId,AircraftId"];
AircraftSeat -> FlightSeat [label="1 : 0..N\nAircraftId,SeatNo,CabinCode"];
Flight -> CrewAssignment [label="1 : 0..N\nFlightId"];
Employee -> CrewAssignment [label="1 : 0..N\nEmployeeId"];
}
