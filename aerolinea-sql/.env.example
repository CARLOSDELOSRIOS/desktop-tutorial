AIRLINE_MODE=local
AIRLINE_SERVER=localhost
AIRLINE_DATABASE=AirlinePAC
AIRLINE_AUTH=windows
# Vacío: autodetectar ODBC Driver 18 o 17, en ese orden.
AIRLINE_DRIVER=
# Encrypt=yes siempre. yes solo si se acepta expresamente certificado local autofirmado.
AIRLINE_TRUST_CERTIFICATE=no
# Azure: mode=azure, server=tcp:<servidor>.database.windows.net,1433,
# auth=entra (interactivo) o sql (credenciales solo en variables/.env privado).
# AIRLINE_USER=
# AIRLINE_PASSWORD=
